# Copy to .env at the repo root and fill in. NEVER commit .env.
# Generate strong values with:  openssl rand -base64 24
#
# scripts/init-env.sh does this for you and writes the file directly, so the
# secrets are never echoed to a terminal or pasted into a chat.

# ---------------------------------------------------------------- Postgres
POSTGRES_USER=listmonk
POSTGRES_PASSWORD=CHANGEME_generate_with_openssl_rand
POSTGRES_DB=listmonk

# ---------------------------------------------------------------- Listmonk
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=CHANGEME_generate_with_openssl_rand

# The public site origin. Listmonk builds unsubscribe and confirmation links
# from this, so it must match how readers actually reach the site.
SITE_URL=http://localhost:8080

# Public UUID of the list new subscribers are added to. Left empty until the
# list exists: create it in the Listmonk admin, then run
# ./scripts/sync-list-uuid.sh to fill this in and rebuild the site.
LISTMONK_LIST_UUID=
