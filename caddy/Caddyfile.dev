# Local development and testing. Production config lives in Caddyfile.
#
# Two jobs: serve the static site, and proxy the one Listmonk endpoint readers
# need so the subscribe form is same origin and nobody leaves restai.ee.

:80 {
	root * /srv
	encode gzip zstd

	# Security headers. The CSP is strict because a static site needs no
	# third party anything: no external scripts, no external fonts, no frames.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		Permissions-Policy        "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		X-Frame-Options           "DENY"
		Content-Security-Policy   "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; base-uri 'self'"
		-Server
	}

	# The subscribe form posts here. Rewritten to Listmonk's public endpoint so
	# the reader stays on our origin and no CORS is involved.
	handle /subscribe {
		rewrite * /subscription/form
		reverse_proxy listmonk:9000
	}

	# Listmonk's own pages for confirming, managing and unsubscribing. These are
	# reader facing and must be public.
	handle /subscription/* {
		reverse_proxy listmonk:9000
	}
	handle /link/* {
		reverse_proxy listmonk:9000
	}

	# Everything else is the static site. Note what is NOT proxied: /admin and
	# /api are absent on purpose, so the Listmonk admin panel and API are
	# unreachable from the public origin.
	handle {
		file_server
	}

	# Unknown paths must return a real 404. Serving the 404 page with a 200
	# status made every path look reachable, including /admin, and would let
	# search engines index error pages as content.
	handle_errors {
		@404 expression {err.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
